<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.musicpanel</groupId>
    <artifactId>DiscordMusicPanel</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>DiscordMusicPanel</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
        <jda.version>6.5.0</jda.version>
        <lavaplayer.version>2.2.4</lavaplayer.version>
        <lavasrc.version>4.8.3</lavasrc.version>

        <!--
          Offline speech recognition for the voice commands ("Jarvis, play ...").
          Provided at runtime by Paper's own library loader (see "libraries" in plugin.yml),
          so it is NOT shaded into the jar. The GitHub build replaces this with whatever
          version Maven Central currently lists.
        -->
        <vosk.version>0.3.45</vosk.version>
        <!--
          Vosk's classes extend com.sun.jna.PointerType, and Maven does NOT pass on the
          dependencies of a "provided" library, so JNA has to be named here for compiling.
          Only needed to compile: at runtime Paper pulls it in together with Vosk.
        -->
        <jna.version>5.13.0</jna.version>

        <!--
          YouTube support. YouTube moved to SABR-only streaming formats in Sept 2026, which the last tagged
          youtube-source release (1.18.2) can't play. This is a newer commit that works with it
          (the full 40-char commit hash + "-SNAPSHOT").
          The GitHub build in .github/workflows/build.yml compiles exactly this commit from source,
          so it does not depend on any Maven repository being up to date. To update later: put a newer commit
          hash from https://github.com/lavalink-devs/youtube-source/commits/main here AND in build.yml (YT_COMMIT).
        -->
        <youtube.source.version>2be8e542d3f6f178e048dca565892684c2e40177-SNAPSHOT</youtube.source.version>

        <!-- DAVE (Discord's mandatory voice encryption). Known-good defaults; the GitHub build tries newer ones first. -->
        <libdave.version>0.1.2</libdave.version>
        <libdave.natives.version>0.1.3</libdave.natives.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>lavalink-releases</id>
            <url>https://maven.lavalink.dev/releases</url>
        </repository>
        <repository>
            <id>lavalink-snapshots</id>
            <url>https://maven.lavalink.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
            <id>topi-releases</id>
            <url>https://maven.topi.wtf/releases</url>
        </repository>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Server API (provided by the server at runtime) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
            <scope>provided</scope>
        </dependency>

        <!-- Discord -->
        <dependency>
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <version>${jda.version}</version>
        </dependency>

        <!-- DAVE end-to-end voice encryption (required by Discord since March 2026) -->
        <dependency>
            <groupId>moe.kyokobot.libdave</groupId>
            <artifactId>adapter-jda</artifactId>
            <version>${libdave.version}</version>
        </dependency>
        <dependency>
            <groupId>moe.kyokobot.libdave</groupId>
            <artifactId>impl-jni</artifactId>
            <version>${libdave.version}</version>
        </dependency>
        <dependency>
            <groupId>moe.kyokobot.libdave</groupId>
            <artifactId>natives-linux-x86-64</artifactId>
            <version>${libdave.natives.version}</version>
        </dependency>
        <dependency>
            <groupId>moe.kyokobot.libdave</groupId>
            <artifactId>natives-linux-aarch64</artifactId>
            <version>${libdave.natives.version}</version>
        </dependency>
        <dependency>
            <groupId>moe.kyokobot.libdave</groupId>
            <artifactId>natives-win-x86-64</artifactId>
            <version>${libdave.natives.version}</version>
        </dependency>

        <!-- Audio -->
        <dependency>
            <groupId>dev.arbjerg</groupId>
            <artifactId>lavaplayer</artifactId>
            <version>${lavaplayer.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.lavalink.youtube</groupId>
            <artifactId>v2</artifactId>
            <version>${youtube.source.version}</version>
        </dependency>

        <!--
          Offline speech-to-text for the voice commands. "provided" on purpose: Paper's library
          loader supplies it at runtime (plugin.yml "libraries"), which keeps the plugin jar small
          and lets Vosk load its own native library the normal way.
        -->
        <dependency>
            <groupId>com.alphacephei</groupId>
            <artifactId>vosk</artifactId>
            <version>${vosk.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>${jna.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Spotify links (metadata via Spotify, audio mirrored from YouTube) -->
        <dependency>
            <groupId>com.github.topi314.lavasrc</groupId>
            <artifactId>lavasrc</artifactId>
            <version>${lavasrc.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- plugin.yml is filtered so the speech library version stays in sync with the property above. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!-- Paper already ships slf4j-api; JDA/Lavaplayer will log through it. -->
                            <artifactSet>
                                <excludes>
                                    <exclude>org.slf4j:slf4j-api</exclude>
                                </excludes>
                            </artifactSet>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <!--
                              Only relocate libraries the Minecraft server itself also ships (parent-first
                              class loading would otherwise pick the server's older copy).
                              Do NOT relocate moe.kyokobot.libdave (JNI) or dev.lavalink.youtube (loaded by name).
                              If you see NoSuchMethodError / LinkageError for another library, relocate it here too.
                            -->
                            <relocations>
                                <relocation>
                                    <pattern>org.apache.commons.io</pattern>
                                    <shadedPattern>dev.musicpanel.libs.commons.io</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.commons.codec</pattern>
                                    <shadedPattern>dev.musicpanel.libs.commons.codec</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.http</pattern>
                                    <shadedPattern>dev.musicpanel.libs.http</shadedPattern>
                                </relocation>
                            </relocations>

                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
